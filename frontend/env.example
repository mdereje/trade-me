# API Configuration
# Local development:
REACT_APP_API_URL=http://localhost:8000

# Production behind Firebase Hosting rewrites (/api/** -> Cloud Run):
# Leave blank (empty string) so requests go to same-origin /api/... without double prefix.
# REACT_APP_API_URL=

# Optional Stripe Publishable Key (Checkout runs hosted on Stripe; publishable key optional)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
