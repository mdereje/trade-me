# Environment: development | test | production
ENV=development

# Database
# Local development:
DATABASE_URL=postgresql://user:password@localhost/trademe
# Cloud SQL socket:
# DATABASE_URL=postgresql://user:password@/trademe?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# JWT Security (REQUIRED in production - generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-strong-64-char-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Base URL (used for Stripe Checkout & Billing Portal redirect URLs)
FRONTEND_URL=http://localhost:3000
FIREBASE_PROJECT_ID=trade-me-13f73

# Stripe Billing ($0.99/month & $10/year)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY_ID=price_monthly_99_cents
STRIPE_PRICE_ANNUAL_ID=price_annual_10_dollars
STRIPE_TRIAL_DAYS=0

# Photo Storage (leave GCS_BUCKET_NAME blank in local dev to store under static/uploads)
GCS_BUCKET_NAME=
UPLOAD_DIR=static/uploads
MAX_FILE_SIZE=10485760

# Optional: Social Auth (endpoints fail closed when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional: Twilio SMS Phone Verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
